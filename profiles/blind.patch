# erax accessibility profile: blind
#
# Non-visual operation. Enables the blindness profile master, which
# brings the accessibility cue bus live for the non-visual senses
# (the stock config already sets ANNOUNCE_CURSOR_LINE and
# CUE_ERROR_BELL). Applies with: patch -p1 --forward. Reversible
# with: patch -R -p1 --forward (see accessibility.sh).
--- a/src/config/accessibility/blindness.rs
+++ b/src/config/accessibility/blindness.rs
@@ -22,7 +22,7 @@
 /// in this module. This is the constant the `blind` accessibility
 /// profile flips; it exists so profiles compose by class without
 /// sharing patch ground.
-pub const BLIND_PROFILE: bool = false;
+pub const BLIND_PROFILE: bool = true;

 /// Which speech backend the editor wires in for voice input (STT)
 /// and spoken output (TTS).
