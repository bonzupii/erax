# erax accessibility profile: deaf
#
# Visual equivalents of audio cues. Enables the deafness profile
# master, which brings the accessibility cue bus live for the visual
# senses (the stock config already sets CUE_VISUAL_FLASH). Applies
# with: patch -p1 --forward. Reversible with: patch -R -p1 --forward
# (see accessibility.sh).
--- a/src/config/accessibility/hearing.rs
+++ b/src/config/accessibility/hearing.rs
@@ -16,4 +16,4 @@
 /// this module. This is the constant the `deaf` accessibility profile
 /// flips; it exists so profiles compose by class without sharing
 /// patch ground.
-pub const DEAF_PROFILE: bool = false;
+pub const DEAF_PROFILE: bool = true;
